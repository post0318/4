# 매수 주문 이메일 받는사람/참조 기본값 (화면에서 수정 가능, 여러 명은 ; 로 구분)
ORDER_EMAIL_TO=a@example.com; b@example.com
ORDER_EMAIL_CC=

# 「테스트 발송」 체크 시 실제 수신자 대신 이 주소로만 보낸다.
# 미설정 시 ORDER_EMAIL_FROM 을 쓰고, 둘 다 없으면 테스트 발송이 거부된다.
# ORDER_EMAIL_TEST_TO=dev@example.com

# 이메일 제목/인사말/서명 (미설정 시 orderEmail.ts의 기본값 사용).
# 인사말은 줄바꿈을 리터럴 \n 으로 넣는다. 제목은 "{접두어} {주문일}".
# ORDER_EMAIL_SUBJECT_PREFIX=한화투자증권 브라질국채 매수
# ORDER_EMAIL_GREETING=안녕하세요. 한화투자증권 상품운용팀입니다.\n금일 채권 매수 요청드립니다.\n감사합니다.
# ORDER_EMAIL_SIGNATURE=홍길동 드림

# --- 실제 이메일 전송 연동 시 (현재 미사용) ---
# 방식 A) Resend
# RESEND_API_KEY=
# ORDER_EMAIL_FROM=orders@yourdomain.com
#
# 방식 B) Gmail SMTP (nodemailer)
# SMTP_USER=you@gmail.com
# SMTP_PASS=            # Google 앱 비밀번호 (16자리)

# --- 현금흐름 공유 링크 (감사 ⑤ 중10) ---
# 서명형 링크(?p=) 비밀키. 16자 이상 무작위 문자열. 바꾸면 기존 서명 링크가 전부 무효.
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 미설정 시 로컬 개발에서는 고정 개발 키를 쓰고, 운영(Vercel)에서는 서명형이 꺼진다.
# SHARE_LINK_SECRET=
# 서버저장형 링크(?t=) 저장소 — Vercel 마켓플레이스 Upstash Redis 를 붙이면 자동 주입.
# 로컬에서 미설정이면 .data/share-links.json 파일을 대신 쓴다(커밋 안 됨).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# 서버저장형 링크 유효기간(일). 기본 180.
# SHARE_LINK_TTL_DAYS=180

# --- 트레이딩 탭·링크 생성 로그인 (Clerk, 감사 ⑤ 치명1) ---
# Vercel 마켓플레이스에서 Clerk 를 연결하면 아래 두 개가 자동 주입된다. 로컬은
# `vercel env pull` 로 받거나 Vercel 환경변수 화면에서 복사. 없으면 인증이 꺼지고
# 트레이딩 탭·링크 생성만 "인증 서비스 미설정"으로 잠긴다.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# 가입·사용 허용 회사 이메일 도메인(쉼표 구분). 기본 hanwha.com
# ALLOWED_EMAIL_DOMAINS=hanwha.com
# 도메인과 무관하게 통과하는 관리자 이메일(쉼표 구분). 서버에서만 읽고 화면엔 안 내려감.
# ADMIN_EMAILS=admin@example.com

# --- 글로벌 뉴스 클릭 요약 (비용 0 원칙) ---
# 오라클 스케줄러(scripts/oracle-news-summary.mjs)가 pending/ingest API 를 부를 때 쓰는 Bearer 토큰.
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NEWS_INGEST_TOKEN
# (선택) 클릭 시 생성 — 결제를 연결하지 않은 Google 프로젝트의 무료 키만. 위클리 앱 키 금지(크레딧 결제).
# GEMINI_API_KEY
# GEMINI_MODEL
# NEWS_SUMMARY_DAILY_CAP

# --- 트레이딩 탭·주문 발송·공유 링크 생성 (기본 꺼짐, 코드 보관) ---
# 1 이면 켠다. 이메일 발송(sendEmail)이 연결되기 전까지 운영에서는 비워 둔다.
# TRADING_ENABLED=1
